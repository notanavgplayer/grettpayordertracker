// firestore.rules
// Deploy these in Firebase Console → Firestore → Rules
// OR run: firebase deploy --only firestore:rules

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Only authenticated users can read/write pay orders
    match /payOrders/{docId} {
      allow read, write: if request.auth != null;
    }

    // Only authenticated users can read/write activity log
    match /activityLog/{docId} {
      allow read, write: if request.auth != null;
    }

    // Block everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
