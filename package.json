{
  "name": "grett-pay-order-tracker",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "test": "npm run test:unit && npm run test:ui",
    "test:unit": "node --test test/domain.test.js test/billingLedger.test.js test/integrations.test.js test/firestore.rules.test.js test/calendarTodo.test.js test/documentDownload.test.js test/documentUpload.test.js test/tenderSave.test.js",
    "test:ui": "vitest run --maxWorkers=1 --fileParallelism=false --reporter=dot",
    "test:rules": "npx --yes firebase-tools@15.30.2 emulators:exec --only firestore \"npm test\"",
    "check:csp": "node scripts/check-csp.mjs",
    "check": "npm run lint && npm test && npm run check:csp && npm run build",
    "preview": "vite preview"
  },
